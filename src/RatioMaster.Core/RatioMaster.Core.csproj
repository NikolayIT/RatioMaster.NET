<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RatioMaster.Core</RootNamespace>
    <AssemblyName>RatioMaster.Core</AssemblyName>
    <Description>RatioMaster.NET core: bencode, torrent files, client emulation profiles, tracker protocol, session engine.</Description>
    <!-- Required by the LibraryImport source generator used for the Windows process-memory reader. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Clients\clients.json" LogicalName="RatioMaster.Core.Clients.clients.json" />
  </ItemGroup>

  <!-- User-facing messages. Strings.resx is English; Strings.<culture>.resx become satellite assemblies.
       The Strings class is generated at build time, so there is no checked-in Designer file. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>RatioMaster.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RatioMaster.Core.Tests" />
  </ItemGroup>

</Project>

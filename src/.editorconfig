root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,axaml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_sort_system_directives_first = true

# Members are qualified with "this." and private fields are camelCase with no underscore,
# matching the house style. SA1101 and SA1309 enforce the same thing on build.
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning

dotnet_naming_rule.private_fields_are_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case.style = camel_case_no_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_no_prefix.capitalization = camel_case
dotnet_diagnostic.CA1416.severity = error

# ---- Analyzers -------------------------------------------------------------
# StyleCop.Analyzers is referenced for the layout and readability rules that the built-in
# .NET analyzers and the IDExxxx rules do not cover. Anything the modern analyzers already
# handle, and anything that argues with the style this codebase is written in, is off here
# rather than "fixed" by churning 144 files.

# Handled better by the IDExxxx rules and the dotnet_style_* preferences above.
dotnet_diagnostic.SA1121.severity = none   # use built-in type alias; IDE0049 covers it
dotnet_diagnostic.SA1200.severity = none   # usings inside namespace; file-scoped namespaces are used everywhere
dotnet_diagnostic.SA1516.severity = none   # blank line between elements; formatter's job

# Documentation: public API is documented where it earns a comment, not by quota.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1633.severity = none   # file headers; the repo has none and does not want them
dotnet_diagnostic.SA1642.severity = none
dotnet_diagnostic.SA1643.severity = none
dotnet_diagnostic.SA1611.severity = none   # a param tag per parameter, whether or not it says anything
dotnet_diagnostic.SA1615.severity = none   # ditto for returns

# The "// ---- Section ----" banners that split the longer files are meant to have a blank
# line on both sides; SA1515 (blank line before a comment) stays on and is honoured.
dotnet_diagnostic.SA1512.severity = none

# Left on and enforced: the "this." prefix (SA1101), camelCase private fields (SA1309),
# element ordering (SA1201/1202/1203/1204/1214), one type per file (SA1402/SA1649),
# arithmetic precedence (SA1407), parameter wrapping (SA1117), using order (SA1208/SA1210),
# blank lines (SA1507/SA1515), trailing commas (SA1413), and the rest of the SA1xxx rules.

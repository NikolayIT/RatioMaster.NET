<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RatioMaster.App.Resources"
        xmlns:vm="clr-namespace:RatioMaster.App.ViewModels"
        xmlns:conv="clr-namespace:RatioMaster.App.Converters"
        xmlns:controls="clr-namespace:RatioMaster.App.Views.Controls"
        xmlns:updates="clr-namespace:RatioMaster.Core.Updates;assembly=RatioMaster.Core"
        x:Class="RatioMaster.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RatioMaster.NET"
        Width="1340" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://RatioMaster.NET/Assets/app.ico">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding AddTorrentCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding AddTorrentCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding UpdateSelectedCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding RenameSelectedCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding RemoveSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding StartSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+OemPeriod" Command="{Binding StopSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Enter" Command="{Binding StartAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+OemPeriod" Command="{Binding StopAllCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding UpdateAllCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding LoadSessionCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding LoadSessionAndStartCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSessionCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding StopAllAndSaveSessionCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleDetailsPaneCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyInfoHashCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding ExitCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{x:Static res:Strings.MenuFile}">
        <MenuItem Header="{x:Static res:Strings.MenuAddTorrent}" Command="{Binding AddTorrentCommand}" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuLoadSession}" Command="{Binding LoadSessionCommand}" InputGesture="Ctrl+L" />
        <MenuItem Header="{x:Static res:Strings.MenuLoadSessionAndStart}" Command="{Binding LoadSessionAndStartCommand}" InputGesture="Ctrl+Shift+L" />
        <MenuItem Header="{x:Static res:Strings.MenuSaveSession}" Command="{Binding SaveSessionCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="{x:Static res:Strings.MenuStopAllAndSaveSession}" Command="{Binding StopAllAndSaveSessionCommand}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuSettings}" Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+OemComma" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}" InputGesture="Ctrl+Q" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.MenuTorrent}">
        <MenuItem Header="{x:Static res:Strings.CommandStart}" Command="{Binding StartSelectedCommand}" InputGesture="Ctrl+Enter" />
        <MenuItem Header="{x:Static res:Strings.CommandStop}" Command="{Binding StopSelectedCommand}" InputGesture="Ctrl+OemPeriod" />
        <MenuItem Header="{x:Static res:Strings.CommandUpdateNow}" Command="{Binding UpdateSelectedCommand}" InputGesture="F5" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.CommandRename}" Command="{Binding RenameSelectedCommand}" InputGesture="F2" />
        <MenuItem Header="{x:Static res:Strings.CommandRemove}" Command="{Binding RemoveSelectedCommand}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.CommandCopyInfoHash}" Command="{Binding CopyInfoHashCommand}" InputGesture="Ctrl+Shift+C" />
        <MenuItem Header="{x:Static res:Strings.CommandUseAsDefaults}" Command="{Binding UseSelectedAsDefaultsCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.MenuAll}">
        <MenuItem Header="{x:Static res:Strings.CommandStartAll}" Command="{Binding StartAllCommand}" InputGesture="Ctrl+Shift+Enter" />
        <MenuItem Header="{x:Static res:Strings.CommandStopAll}" Command="{Binding StopAllCommand}" InputGesture="Ctrl+Shift+OemPeriod" />
        <MenuItem Header="{x:Static res:Strings.CommandUpdateAll}" Command="{Binding UpdateAllCommand}" InputGesture="Shift+F5" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuSetUploadSpeedForAll}" Command="{Binding SetUploadSpeedForAllCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuSetDownloadSpeedForAll}" Command="{Binding SetDownloadSpeedForAllCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuClearAllLogs}" Command="{Binding ClearAllLogsCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.MenuView}">
        <MenuItem Header="{x:Static res:Strings.MenuDetailsPane}" ToggleType="CheckBox" InputGesture="Ctrl+D"
                  IsChecked="{Binding IsDetailsPaneVisible, Mode=TwoWay}" />
        <MenuItem Name="ColumnsMenu" Header="{x:Static res:Strings.MenuColumns}" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.MenuHelp}">
        <MenuItem Header="{x:Static res:Strings.MenuProgramWebsite}" Command="{Binding OpenUrlCommand}" CommandParameter="https://ratiomaster.net" />
        <MenuItem Header="GitHub" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/NikolayIT/RatioMaster.NET" />
        <MenuItem Header="{x:Static res:Strings.Forums}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/NikolayIT/RatioMaster.NET/discussions" />
        <MenuItem Header="{x:Static res:Strings.ReportBug}" Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static updates:AppVersion.BugReportUrl}" />
        <MenuItem Header="{x:Static res:Strings.Donate}" Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static updates:AppVersion.DonateUrl}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
        <MenuItem Header="{x:Static res:Strings.AboutRatioMaster}" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="toolbar" Command="{Binding AddTorrentCommand}" ToolTip.Tip="{x:Static res:Strings.TipAdd}"
                  AutomationProperties.Name="{x:Static res:Strings.ToolbarAdd}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconAdd}" />
              <TextBlock Text="{x:Static res:Strings.ToolbarAdd}" />
            </StackPanel>
          </Button>
          <Rectangle Classes="toolbar-separator" />
          <Button Classes="toolbar" Command="{Binding StartSelectedCommand}" ToolTip.Tip="{x:Static res:Strings.TipStart}"
                  AutomationProperties.Name="{x:Static res:Strings.CommandStart}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconStart}" />
              <TextBlock Text="{x:Static res:Strings.CommandStart}" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding StopSelectedCommand}" ToolTip.Tip="{x:Static res:Strings.TipStop}"
                  AutomationProperties.Name="{x:Static res:Strings.CommandStop}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconStop}" />
              <TextBlock Text="{x:Static res:Strings.CommandStop}" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding UpdateSelectedCommand}" ToolTip.Tip="{x:Static res:Strings.TipUpdate}"
                  AutomationProperties.Name="{x:Static res:Strings.ToolbarUpdate}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconUpdate}" />
              <TextBlock Text="{x:Static res:Strings.ToolbarUpdate}" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding RemoveSelectedCommand}" ToolTip.Tip="{x:Static res:Strings.TipRemove}"
                  AutomationProperties.Name="{x:Static res:Strings.CommandRemove}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconRemove}" />
              <TextBlock Text="{x:Static res:Strings.CommandRemove}" />
            </StackPanel>
          </Button>
          <Rectangle Classes="toolbar-separator" />
          <Button Classes="toolbar" Command="{Binding StartAllCommand}" ToolTip.Tip="{x:Static res:Strings.TipStartAll}"
                  AutomationProperties.Name="{x:Static res:Strings.CommandStartAll}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconStartAll}" />
              <TextBlock Text="{x:Static res:Strings.CommandStartAll}" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding StopAllCommand}" ToolTip.Tip="{x:Static res:Strings.TipStopAll}"
                  AutomationProperties.Name="{x:Static res:Strings.CommandStopAll}">
            <StackPanel>
              <PathIcon Classes="toolbar" Data="{StaticResource IconStopAll}" />
              <TextBlock Text="{x:Static res:Strings.CommandStopAll}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ComboBox MinWidth="130" MinHeight="32" VerticalAlignment="Center" ToolTip.Tip="{x:Static res:Strings.TipFilter}"
                    ItemsSource="{x:Static vm:MainWindowViewModel.Filters}" SelectedItem="{Binding Filter}"
                    ItemTemplate="{StaticResource DisplayNameTemplate}" />
          <TextBox Name="SearchBox" Width="220" MinHeight="32" VerticalAlignment="Center"
                   PlaceholderText="{x:Static res:Strings.SearchPlaceholder}" Text="{Binding SearchText}">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="8,0,0,0" Opacity="0.6" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Rectangle Classes="toolbar-separator" />
          <Button Classes="toolbar" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{x:Static res:Strings.TipSettings}"
                  AutomationProperties.Name="{x:Static res:Strings.Settings}">
            <PathIcon Classes="toolbar" Data="{StaticResource IconSettings}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" />
        <Rectangle Grid.Column="1" Classes="separator" />
        <TextBlock Grid.Column="2" Text="{Binding AggregateSpeeds}" />
        <Rectangle Grid.Column="3" Classes="separator"
                   IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <HyperlinkButton Grid.Column="4" Content="{Binding UpdateMessage}" Command="{Binding CheckForUpdatesCommand}"
                         IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Column="6" Classes="subtle">
          <Run Text="{x:Static res:Strings.StatusLocalIp}" />
          <Run Text="{Binding LocalIpText}" />
        </TextBlock>
        <Rectangle Grid.Column="7" Classes="separator" />
        <TextBlock Grid.Column="8" Text="{Binding VersionText}" Classes="subtle" />
      </Grid>
    </Border>

    <!-- Torrent list + details -->
    <Grid Name="ContentGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <!-- The details row is a pixel height managed from code-behind: it follows the splitter,
             is clamped to the window and collapses to zero when the pane is hidden. -->
        <RowDefinition Height="300" MinHeight="140" />
      </Grid.RowDefinitions>

      <Panel Grid.Row="0">
        <!-- Column bindings are evaluated per row, so this grid uses reflection bindings. -->
        <DataGrid Name="TorrentGrid"
                  Classes="torrents"
                  x:CompileBindings="False"
                  ItemsSource="{Binding TorrentsView}"
                  SelectedItem="{Binding SelectedTorrent}">
          <DataGrid.Columns>
            <DataGridTextColumn Tag="Name" Header="{x:Static res:Strings.Name}" Binding="{Binding DisplayName, Mode=OneWay}" Width="*" MinWidth="180" />
            <DataGridTemplateColumn Tag="Status" Header="{x:Static res:Strings.Status}" Width="135" MinWidth="80" SortMemberPath="State">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                  <!-- A grid rather than a stack panel, so a long status (an error) is trimmed with an ellipsis. -->
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Width="11" Height="11"
                              Data="{Binding State, Converter={x:Static conv:Converters.StatusIcon}}"
                              Foreground="{Binding State, Converter={x:Static conv:Converters.StatusBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding StatusText}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Tag="Client" Header="{x:Static res:Strings.Client}" Binding="{Binding ClientName, Mode=OneWay}" Width="130" MinWidth="60" />
            <DataGridTemplateColumn Tag="Progress" Header="{x:Static res:Strings.ColumnProgress}" Width="110" MinWidth="70" SortMemberPath="Progress">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                  <Grid ColumnDefinitions="*,44" VerticalAlignment="Center">
                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" MinWidth="20" />
                    <TextBlock Grid.Column="1" FontSize="12" TextAlignment="Right"
                               Text="{Binding Progress, Converter={x:Static conv:Converters.Percent}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Tag="Uploaded" Header="{x:Static res:Strings.Uploaded}" Width="90" MinWidth="50"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding Uploaded, Mode=OneWay, Converter={x:Static conv:Converters.Bytes}}"
                                SortMemberPath="Uploaded" />
            <DataGridTextColumn Tag="Downloaded" Header="{x:Static res:Strings.Downloaded}" Width="105" MinWidth="50"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding Downloaded, Mode=OneWay, Converter={x:Static conv:Converters.Bytes}}"
                                SortMemberPath="Downloaded" />
            <DataGridTextColumn Tag="Ratio" Header="{x:Static res:Strings.Ratio}" Width="62" MinWidth="40"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding Ratio, Mode=OneWay, Converter={x:Static conv:Converters.Ratio}}"
                                SortMemberPath="Ratio" />
            <DataGridTextColumn Tag="Up speed" Header="{x:Static res:Strings.ColumnUpSpeed}" Width="90" MinWidth="50"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding UploadRate, Mode=OneWay, Converter={x:Static conv:Converters.Speed}}"
                                SortMemberPath="UploadRate" />
            <DataGridTextColumn Tag="Down speed" Header="{x:Static res:Strings.ColumnDownSpeed}" Width="105" MinWidth="50"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding DownloadRate, Mode=OneWay, Converter={x:Static conv:Converters.Speed}}"
                                SortMemberPath="DownloadRate" />
            <DataGridTextColumn Tag="Seeds" Header="{x:Static res:Strings.Seeds}" Width="68" MinWidth="40"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding Seeders, Mode=OneWay, Converter={x:Static conv:Converters.Count}}"
                                SortMemberPath="Seeders" />
            <DataGridTextColumn Tag="Leechers" Header="{x:Static res:Strings.Leechers}" Width="85" MinWidth="40"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding Leechers, Mode=OneWay, Converter={x:Static conv:Converters.Count}}"
                                SortMemberPath="Leechers" />
            <DataGridTextColumn Tag="Update in" Header="{x:Static res:Strings.ColumnUpdateIn}" Width="88" MinWidth="50"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding NextUpdateIn, Mode=OneWay, Converter={x:Static conv:Converters.Duration}}"
                                SortMemberPath="NextUpdateIn" />
            <DataGridTextColumn Tag="Total time" Header="{x:Static res:Strings.TotalTime}" Width="90" MinWidth="50" IsVisible="False"
                                CellTheme="{StaticResource DataGridCellNumeric}"
                                HeaderTemplate="{StaticResource DataGridHeaderNumeric}"
                                Binding="{Binding TotalRunningTime, Mode=OneWay, Converter={x:Static conv:Converters.Duration}}"
                                SortMemberPath="TotalRunningTime" />
            <DataGridTextColumn Tag="Tracker" Header="{x:Static res:Strings.Tracker}" Width="160" MinWidth="60" IsVisible="False"
                                Binding="{Binding TrackerHost, Mode=OneWay}" SortMemberPath="TrackerHost" />
          </DataGrid.Columns>

          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.CommandStart}" Command="{Binding StartSelectedCommand}" InputGesture="Ctrl+Enter" />
              <MenuItem Header="{x:Static res:Strings.CommandStop}" Command="{Binding StopSelectedCommand}" InputGesture="Ctrl+OemPeriod" />
              <MenuItem Header="{x:Static res:Strings.CommandUpdateNow}" Command="{Binding UpdateSelectedCommand}" InputGesture="F5" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.CommandRename}" Command="{Binding RenameSelectedCommand}" InputGesture="F2" />
              <MenuItem Header="{x:Static res:Strings.CommandRemove}" Command="{Binding RemoveSelectedCommand}" InputGesture="Delete" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.CommandCopyInfoHash}" Command="{Binding CopyInfoHashCommand}" InputGesture="Ctrl+Shift+C" />
              <MenuItem Header="{x:Static res:Strings.CommandUseAsDefaults}" Command="{Binding UseSelectedAsDefaultsCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Empty state -->
        <StackPanel IsVisible="{Binding !HasTorrents}" Spacing="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconAdd}" Width="40" Height="40" Opacity="0.35" />
          <TextBlock Text="{x:Static res:Strings.EmptyNoTorrents}" FontSize="18" HorizontalAlignment="Center" />
          <TextBlock Classes="subtle" HorizontalAlignment="Center"
                     Text="{x:Static res:Strings.EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
          <Button Content="{x:Static res:Strings.AddTorrent}" HorizontalAlignment="Center" Command="{Binding AddTorrentCommand}" />
        </StackPanel>
      </Panel>

      <GridSplitter Name="DetailsSplitter" Grid.Row="1" Classes="details"
                    IsVisible="{Binding IsDetailsPaneVisible}" />

      <Panel Grid.Row="2" IsVisible="{Binding IsDetailsPaneVisible}">
        <controls:TorrentDetailsView DataContext="{Binding SelectedTorrent}" />
        <Button Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,8,0"
                Command="{Binding ToggleDetailsPaneCommand}" ToolTip.Tip="{x:Static res:Strings.TipHideDetailsPane}"
                AutomationProperties.Name="{x:Static res:Strings.TipHideDetailsPane}">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Panel>
    </Grid>

  </DockPanel>
</Window>

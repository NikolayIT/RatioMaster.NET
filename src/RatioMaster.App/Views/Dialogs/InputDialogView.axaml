<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             x:Class="RatioMaster.App.Views.Dialogs.InputDialogView"
             x:DataType="vm:InputDialogViewModel">
  <StackPanel Margin="20" Spacing="12" Width="440">
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    <TextBox Text="{Binding Value}" Name="ValueBox" />
    <StackPanel Classes="dialog-buttons" Margin="0,8,0,0">
      <Button Content="OK" IsDefault="True" Classes="accent" Command="{Binding AcceptCommand}" />
      <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             x:Class="RatioMaster.App.Views.Dialogs.InputDialogView"
             x:DataType="vm:InputDialogViewModel">
  <StackPanel Margin="20" Spacing="14" Width="420">
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    <TextBox Text="{Binding Value}" Name="ValueBox" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="OK" MinWidth="90" IsDefault="True" Command="{Binding AcceptCommand}" />
      <Button Content="Cancel" MinWidth="90" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RatioMaster.App.Resources"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             x:Class="RatioMaster.App.Views.Dialogs.AboutView"
             x:DataType="vm:AboutViewModel"
             Width="560">

  <UserControl.Styles>
    <Style Selector="HyperlinkButton.about">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="20" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <Image Source="avares://RatioMaster.NET/Assets/app.png" Width="56" Height="56" VerticalAlignment="Top" />
      <StackPanel Spacing="2">
        <TextBlock Text="RatioMaster.NET" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="subtle">
          <Run Text="{x:Static res:Strings.Version}" />
          <Run Text="{Binding Version}" />
          <Run Text="·" />
          <Run Text="{Binding ReleaseDate}" />
        </TextBlock>
        <TextBlock Classes="subtle" Text="{Binding Runtime}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <TextBlock TextWrapping="Wrap"
               Text="{x:Static res:Strings.AboutDescription}" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Website}" Classes="label subtle" />
      <HyperlinkButton Grid.Row="0" Grid.Column="1" Classes="about"
                       Content="{Binding Website}" Command="{Binding OpenCommand}" CommandParameter="{Binding Website}" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="GitHub" Classes="label subtle" />
      <HyperlinkButton Grid.Row="1" Grid.Column="1" Classes="about"
                       Content="{Binding GitHub}" Command="{Binding OpenCommand}" CommandParameter="{Binding GitHub}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Forums}" Classes="label subtle" />
      <HyperlinkButton Grid.Row="2" Grid.Column="1" Classes="about"
                       Content="{Binding Forum}" Command="{Binding OpenCommand}" CommandParameter="{Binding Forum}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.ReportBug}" Classes="label subtle" />
      <HyperlinkButton Grid.Row="3" Grid.Column="1" Classes="about"
                       Content="{Binding BugReport}" Command="{Binding OpenCommand}" CommandParameter="{Binding BugReport}" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.Donate}" Classes="label subtle" />
      <HyperlinkButton Grid.Row="4" Grid.Column="1" Classes="about"
                       Content="{x:Static res:Strings.AboutPayPal}" Command="{Binding DonateCommand}" />
      <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static res:Strings.AboutEmail}" Classes="label subtle" />
      <HyperlinkButton Grid.Row="5" Grid.Column="1" Classes="about"
                       Content="{Binding Email}" Command="{Binding EmailCommand}" />
    </Grid>

    <TextBlock Text="{Binding Copyright}" Classes="subtle" TextWrapping="Wrap" />

    <StackPanel Classes="dialog-buttons" Margin="0,4,0,0">
      <Button Content="{x:Static res:Strings.Donate}" Command="{Binding DonateCommand}" />
      <Button Content="{x:Static res:Strings.ButtonClose}" IsDefault="True" IsCancel="True" Command="{Binding CloseDialogCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>

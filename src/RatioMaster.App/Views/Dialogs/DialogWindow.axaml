<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RatioMaster.App.Views.Dialogs.DialogWindow"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MaxWidth="900" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        Icon="avares://RatioMaster.NET/Assets/app.ico">
  <!-- The content view is resolved from the dialog's view model by the view locator. -->
  <ContentControl Name="Host" />
</Window>

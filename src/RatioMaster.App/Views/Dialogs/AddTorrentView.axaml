<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             xmlns:controls="clr-namespace:RatioMaster.App.Views.Controls"
             x:Class="RatioMaster.App.Views.Dialogs.AddTorrentView"
             x:DataType="vm:AddTorrentViewModel"
             Width="720" Height="660">

  <DockPanel Margin="20">

    <!-- Buttons -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <CheckBox Grid.Column="0" Content="Start immediately" IsChecked="{Binding StartImmediately}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Classes="dialog-buttons">
        <Button Content="Add" IsDefault="True" Classes="accent" Command="{Binding AddCommand}" />
        <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Grid>

    <!-- Torrent picker and info -->
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Browse..." Command="{Binding BrowseCommand}" />
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Classes="subtle" />
      </StackPanel>

      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource LogErrorBrush}"
                 TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4"
              Padding="12,10" IsVisible="{Binding HasTorrents}">
        <StackPanel Spacing="6">
          <ListBox ItemsSource="{Binding Torrents}" SelectedItem="{Binding Selected}" MaxHeight="120"
                   IsVisible="{Binding !IsSingle}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ParsedTorrentViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6"
                IsVisible="{Binding IsSingle}">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tracker" Classes="label" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding TrackerUrls}" SelectedItem="{Binding TrackerUrl}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Details" Classes="label" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="14">
              <TextBlock Classes="subtle" Text="{Binding Selected.Size}" VerticalAlignment="Center" />
              <TextBlock Classes="subtle" Text="{Binding Selected.FileCount}" VerticalAlignment="Center" />
              <SelectableTextBlock Classes="subtle mono" FontSize="12" Text="{Binding Selected.InfoHash}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Settings" Classes="section" Margin="0,6,0,0" />
    </StackPanel>

    <!-- Reused settings editor -->
    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
      <controls:TorrentSettingsView DataContext="{Binding Settings}" />
    </Border>

  </DockPanel>
</UserControl>

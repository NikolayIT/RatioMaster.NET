<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             xmlns:controls="clr-namespace:RatioMaster.App.Views.Controls"
             x:Class="RatioMaster.App.Views.Dialogs.AddTorrentView"
             x:DataType="vm:AddTorrentViewModel"
             Width="700" Height="640">

  <DockPanel Margin="16">

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <CheckBox Content="Start immediately" IsChecked="{Binding StartImmediately}"
                VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Content="Add" MinWidth="100" IsDefault="True" Classes="accent" Command="{Binding AddCommand}" />
      <Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>

    <!-- Torrent picker and info -->
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Browse..." Command="{Binding BrowseCommand}" />
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Classes="subtle" />
      </StackPanel>

      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource LogErrorBrush}"
                 TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4"
              Padding="10" IsVisible="{Binding HasTorrents}">
        <StackPanel Spacing="6">
          <ListBox ItemsSource="{Binding Torrents}" SelectedItem="{Binding Selected}" MaxHeight="120"
                   IsVisible="{Binding !IsSingle}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ParsedTorrentViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsSingle}">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tracker" Classes="label" Margin="0,6,8,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding TrackerUrls}" SelectedItem="{Binding TrackerUrl}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Details" Classes="label" Margin="0,6,8,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
              <TextBlock Classes="subtle" Text="{Binding Selected.Size}" />
              <TextBlock Classes="subtle" Text="{Binding Selected.FileCount}" />
              <SelectableTextBlock Classes="subtle" Text="{Binding Selected.InfoHash}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Settings" Classes="section" />
    </StackPanel>

    <!-- Reused settings editor -->
    <controls:TorrentSettingsView DataContext="{Binding Settings}" />

  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             x:Class="RatioMaster.App.Views.Dialogs.NewVersionView"
             x:DataType="vm:NewVersionViewModel"
             Width="480">
  <StackPanel Margin="20" Spacing="20">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Classes="dialog-buttons">
      <Button Content="Download" IsDefault="True" Classes="accent" Command="{Binding DownloadCommand}" />
      <Button Content="Remind me later" Command="{Binding LaterCommand}" IsCancel="True" />
      <Button Content="Skip this version" Command="{Binding SkipCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>

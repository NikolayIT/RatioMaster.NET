<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             x:Class="RatioMaster.App.Views.Dialogs.NewVersionView"
             x:DataType="vm:NewVersionViewModel"
             Width="460">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Download" MinWidth="100" IsDefault="True" Classes="accent" Command="{Binding DownloadCommand}" />
      <Button Content="Remind me later" Command="{Binding LaterCommand}" IsCancel="True" />
      <Button Content="Skip this version" Command="{Binding SkipCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>

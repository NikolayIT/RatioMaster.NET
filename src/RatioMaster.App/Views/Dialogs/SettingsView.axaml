<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels.Dialogs"
             xmlns:controls="clr-namespace:RatioMaster.App.Views.Controls"
             x:Class="RatioMaster.App.Views.Dialogs.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="700" Height="580">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Bottom" Classes="dialog-buttons" Margin="0,16,0,0">
      <Button Content="Save" IsDefault="True" Classes="accent" Command="{Binding SaveCommand}" />
      <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>

    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
      <TabControl Padding="0">
        <TabControl.Styles>
          <Style Selector="TabControl > TabItem:nth-child(1)">
            <Setter Property="Margin" Value="6,0,2,0" />
          </Style>
        </TabControl.Styles>

        <TabItem Header="General">
          <StackPanel Spacing="10" Margin="16,14">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
              <TextBlock Grid.Column="0" Text="Theme" Classes="label" />
              <ComboBox Grid.Column="1" Width="180" ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Theme}" />
            </Grid>
            <CheckBox Content="Always use a 24-hour clock in logs (otherwise follow the system time format)" IsChecked="{Binding Use24HourTime}" />
            <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckForUpdatesOnStartup}" />
            <CheckBox Content="Restore the last session on startup" IsChecked="{Binding RestoreLastSessionOnStartup}" />
            <CheckBox Content="Add torrents without showing the Add dialog" IsChecked="{Binding AddTorrentsWithoutDialog}" />
            <CheckBox Content="Start torrents immediately after adding them" IsChecked="{Binding StartTorrentsImmediately}" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Tray">
          <StackPanel Spacing="10" Margin="16,14">
            <CheckBox Content="Minimize to the tray" IsChecked="{Binding MinimizeToTray}" />
            <CheckBox Content="Close to the tray instead of quitting" IsChecked="{Binding CloseToTray}" />
            <CheckBox Content="List the torrents in the tray tooltip" IsChecked="{Binding ShowTorrentListInTrayTooltip}" />
            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
            <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="On Linux the tray icon needs a StatusNotifier host (KDE, or GNOME with the AppIndicator extension). Without one a hidden window cannot be brought back, so these two options are off by default there." />
          </StackPanel>
        </TabItem>

        <TabItem Header="Torrent defaults">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="subtle" Margin="16,12,16,4"
                       Text="New torrents start from these settings." />
            <controls:TorrentSettingsView DataContext="{Binding Defaults}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="Clients">
          <StackPanel Spacing="10" Margin="16,14">
            <TextBlock Text="{Binding ClientSummary}" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding UserClientsPath}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="subtle" TextWrapping="Wrap"
                       Text="The file uses the same shape as the built-in catalog. Entries with an existing name replace it; new names are added. Restart the application to pick up changes." />
            <TextBlock Text="Configuration folder" Classes="section" />
            <SelectableTextBlock Text="{Binding ConfigDirectory}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>

      </TabControl>
    </Border>
  </DockPanel>
</UserControl>

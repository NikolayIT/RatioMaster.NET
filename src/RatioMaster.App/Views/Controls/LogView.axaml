<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels"
             xmlns:conv="clr-namespace:RatioMaster.App.Converters"
             xmlns:logging="clr-namespace:RatioMaster.Core.Logging;assembly=RatioMaster.Core"
             x:Class="RatioMaster.App.Views.Controls.LogView"
             x:DataType="vm:LogViewModel">

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <CheckBox Grid.Column="0" Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="0,0,12,0" />
        <CheckBox Grid.Column="1" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="0,0,12,0" />
        <TextBox Grid.Column="2" PlaceholderText="Filter" Text="{Binding FilterText}" MaxWidth="280" HorizontalAlignment="Left" />
        <Button Grid.Column="3" Content="Copy" Command="{Binding CopyAllCommand}" Margin="6,0,0,0" />
        <Button Grid.Column="4" Content="Save..." Command="{Binding SaveCommand}" Margin="6,0,0,0" />
        <Button Grid.Column="5" Content="Clear" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
      </Grid>
    </Border>

    <ListBox Name="Lines" Classes="log" ItemsSource="{Binding Entries}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="logging:LogEntry">
          <TextBlock TextWrapping="NoWrap"
                     Foreground="{Binding Level, Converter={x:Static conv:Converters.LogBrush}}">
            <Run Text="{Binding Time, Converter={x:Static conv:LogTimeConverter.Instance}, Mode=OneWay}"
                 Foreground="{DynamicResource LogTimeBrush}" />
            <Run Text="{Binding Text}" />
          </TextBlock>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>

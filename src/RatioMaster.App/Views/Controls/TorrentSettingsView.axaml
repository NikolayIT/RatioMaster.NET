<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RatioMaster.App.Resources"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels"
             x:Class="RatioMaster.App.Views.Controls.TorrentSettingsView"
             x:DataType="vm:TorrentSettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Expander">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.num">
      <Setter Property="Width" Value="90" />
    </Style>
    <Style Selector="TextBox.wide">
      <Setter Property="MinWidth" Value="240" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="2" Margin="8,8,8,4" Grid.IsSharedSizeScope="True">

      <!-- Client emulation -->
      <Expander Header="{x:Static res:Strings.Client}" IsExpanded="True">
        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="4">
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Client}" Classes="label" />
          <ComboBox Grid.Column="1" Margin="0,0,16,0" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Families}"
                    SelectedItem="{Binding ClientFamily}"
                    IsEnabled="{Binding !IsLocked}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Version}" Classes="label" />
          <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding ClientVersion}"
                    IsEnabled="{Binding !IsLocked}" />
        </Grid>
      </Expander>

      <!-- Speeds -->
      <Expander Header="{x:Static res:Strings.SectionSpeeds}" IsExpanded="True">
        <StackPanel Spacing="8" Margin="4">
          <Grid RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="Label" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LabelUploadSpeed}" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="1" Classes="num" Text="{Binding UploadKb}" />
            <CheckBox Grid.Row="0" Grid.Column="2" Margin="12,0,4,0" Content="{x:Static res:Strings.RandomExtra}"
                      IsChecked="{Binding UploadRandomEnabled}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static res:Strings.RangeMin}" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="4" Width="60" Text="{Binding UploadRandomMinKb}"
                     IsEnabled="{Binding UploadRandomEnabled}" />
            <TextBlock Grid.Row="0" Grid.Column="5" Text="{x:Static res:Strings.RangeMax}" Classes="label" Margin="8,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="6" Width="60" Text="{Binding UploadRandomMaxKb}"
                     IsEnabled="{Binding UploadRandomEnabled}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LabelDownloadSpeed}" Classes="label" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding DownloadKb}" Margin="0,8,0,0" />
            <CheckBox Grid.Row="1" Grid.Column="2" Margin="12,8,4,0" Content="{x:Static res:Strings.RandomExtra}"
                      IsChecked="{Binding DownloadRandomEnabled}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Static res:Strings.RangeMin}" Classes="label" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="4" Width="60" Text="{Binding DownloadRandomMinKb}" Margin="0,8,0,0"
                     IsEnabled="{Binding DownloadRandomEnabled}" />
            <TextBlock Grid.Row="1" Grid.Column="5" Text="{x:Static res:Strings.RangeMax}" Classes="label" Margin="8,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="6" Width="60" Text="{Binding DownloadRandomMaxKb}" Margin="0,8,0,0"
                     IsEnabled="{Binding DownloadRandomEnabled}" />
          </Grid>

          <CheckBox Content="{x:Static res:Strings.PauseNoLeechers}"
                    IsChecked="{Binding StopUploadWhenNoLeechers}" />
          <TextBlock Text="{x:Static res:Strings.PauseNoLeechersHint}"
                     Classes="subtle" Margin="28,-4,0,0" TextWrapping="Wrap" />

          <Separator />
          <TextBlock Text="{x:Static res:Strings.NextUpdateRandomHint}" Classes="subtle" TextWrapping="Wrap" />
          <Grid RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="Label" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="0" Content="{x:Static res:Strings.Upload}" IsChecked="{Binding NextUpdateRandomUpload}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static res:Strings.RangeMin}" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="2" Width="70" Text="{Binding NextUpdateUploadMinKb}"
                     IsEnabled="{Binding NextUpdateRandomUpload}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static res:Strings.RangeMax}" Classes="label" Margin="8,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="4" Width="70" Text="{Binding NextUpdateUploadMaxKb}"
                     IsEnabled="{Binding NextUpdateRandomUpload}" />

            <CheckBox Grid.Row="1" Grid.Column="0" Content="{x:Static res:Strings.Download}" Margin="0,8,0,0"
                      IsChecked="{Binding NextUpdateRandomDownload}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.RangeMin}" Classes="label" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="2" Width="70" Text="{Binding NextUpdateDownloadMinKb}" Margin="0,8,0,0"
                     IsEnabled="{Binding NextUpdateRandomDownload}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Static res:Strings.RangeMax}" Classes="label" Margin="8,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="4" Width="70" Text="{Binding NextUpdateDownloadMaxKb}" Margin="0,8,0,0"
                     IsEnabled="{Binding NextUpdateRandomDownload}" />
          </Grid>
        </StackPanel>
      </Expander>

      <!-- Schedule and stop -->
      <Expander Header="{x:Static res:Strings.SectionSchedule}" IsExpanded="True">
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="Label" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LabelFinished}" Classes="label" />
          <TextBox Grid.Row="0" Grid.Column="1" Classes="num" Text="{Binding FinishedPercent}"
                   IsEnabled="{Binding !IsLocked}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Classes="subtle" VerticalAlignment="Center"
                     Margin="12,0,0,0" Text="{x:Static res:Strings.FinishedHint}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LabelUpdateInterval}" Classes="label" Margin="0,8,8,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding IntervalSeconds}" Margin="0,8,0,0"
                   IsEnabled="{Binding !IsLocked}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="subtle" VerticalAlignment="Center"
                     Margin="12,8,0,0" Text="{x:Static res:Strings.UpdateIntervalHint}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.LabelStop}" Classes="label" Margin="0,8,8,0" />
          <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="220" Margin="0,8,0,0"
                    ItemsSource="{x:Static vm:TorrentSettingsViewModel.StopTypes}"
                    SelectedItem="{Binding StopType}"
                    ItemTemplate="{StaticResource DisplayNameTemplate}"
                    IsEnabled="{Binding !IsLocked}" />
          <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="12,8,0,0"
                      IsVisible="{Binding IsStopValueVisible}">
            <TextBox Width="90" Text="{Binding StopValue}" IsEnabled="{Binding !IsLocked}" />
            <TextBlock Text="{Binding StopValueUnit}" Classes="label" />
          </StackPanel>
        </Grid>
      </Expander>

      <!-- Identity -->
      <Expander Header="{x:Static res:Strings.SectionIdentity}">
        <StackPanel Spacing="8" Margin="4">
          <RadioButton GroupName="identity" IsChecked="{Binding UseAutomaticIdentity}"
                       Content="{x:Static res:Strings.IdentityAutomatic}" />
          <RadioButton GroupName="identity" IsChecked="{Binding !UseAutomaticIdentity}" Content="{x:Static res:Strings.IdentityCustom}" />
          <Grid RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="IdentityLabel" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="IdentityLabel2" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.PeerId}" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="1" Classes="ltr" Text="{Binding PeerId}" IsEnabled="{Binding !UseAutomaticIdentity}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:Strings.LabelKey}" Classes="label" Margin="12,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="3" Classes="ltr" Width="140" Text="{Binding Key}" IsEnabled="{Binding !UseAutomaticIdentity}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Port}" Classes="label" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0"
                     Text="{Binding Port}" IsEnabled="{Binding !IsLocked}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static res:Strings.LabelPeersWanted}" Classes="label" Margin="12,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="3" Width="140" Margin="0,8,0,0"
                     Text="{Binding NumWant}" IsEnabled="{Binding !IsLocked}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{x:Static res:Strings.ButtonRegenerate}" Command="{Binding RegenerateIdentityCommand}"
                    IsEnabled="{Binding !IsGeneratingIdentity}" />
            <TextBlock Text="{Binding IdentityStatus}" Classes="subtle" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <!-- Proxy -->
      <Expander Header="{x:Static res:Strings.Proxy}">
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="IdentityLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="IdentityLabel2" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LabelProxyType}" Classes="label" />
          <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Static vm:TorrentSettingsViewModel.ProxyTypes}"
                    SelectedItem="{Binding ProxyType}"
                    ItemTemplate="{StaticResource DisplayNameTemplate}"
                    IsEnabled="{Binding !IsLocked}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LabelHost}" Classes="label" Margin="0,8,8,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Classes="ltr" Margin="0,8,0,0" Text="{Binding ProxyHost}"
                   IsEnabled="{Binding IsProxyConfigured}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static res:Strings.Port}" Classes="label" Margin="12,8,8,0" />
          <TextBox Grid.Row="1" Grid.Column="3" Width="140" Margin="0,8,0,0" Text="{Binding ProxyPort}"
                   IsEnabled="{Binding IsProxyConfigured}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.LabelUser}" Classes="label" Margin="0,8,8,0" />
          <TextBox Grid.Row="2" Grid.Column="1" Classes="ltr" Margin="0,8,0,0" Text="{Binding ProxyUsername}"
                   IsEnabled="{Binding IsProxyConfigured}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Static res:Strings.LabelPassword}" Classes="label" Margin="12,8,8,0" />
          <TextBox Grid.Row="2" Grid.Column="3" Classes="ltr" Width="140" Margin="0,8,0,0" Text="{Binding ProxyPassword}"
                   PasswordChar="•" RevealPassword="{Binding $self.IsFocused}"
                   IsEnabled="{Binding IsProxyConfigured}" />
        </Grid>
      </Expander>

      <!-- Other -->
      <Expander Header="{x:Static res:Strings.SectionOther}">
        <StackPanel Spacing="6" Margin="4">
          <CheckBox Content="{x:Static res:Strings.OptionRequestScrape}" IsChecked="{Binding RequestScrape}" />
          <CheckBox Content="{x:Static res:Strings.OptionAnswerHandshakes}"
                    IsChecked="{Binding UseTcpListener}" IsEnabled="{Binding !IsProxyConfigured}" />
          <CheckBox Content="{x:Static res:Strings.OptionIgnoreFailureReason}"
                    IsChecked="{Binding IgnoreFailureReason}" />
          <CheckBox Content="{x:Static res:Strings.OptionKeepLog}" IsChecked="{Binding EnableLog}" />
          <CheckBox Content="{x:Static res:Strings.OptionIgnoreCertificateErrors}"
                    IsChecked="{Binding IgnoreCertificateErrors}" />
        </StackPanel>
      </Expander>

    </StackPanel>
  </ScrollViewer>
</UserControl>

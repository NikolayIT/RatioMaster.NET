<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RatioMaster.App.Resources"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels"
             xmlns:conv="clr-namespace:RatioMaster.App.Converters"
             xmlns:tracker="clr-namespace:RatioMaster.Core.Tracker;assembly=RatioMaster.Core"
             x:Class="RatioMaster.App.Views.Controls.TrackerHistoryView"
             x:DataType="vm:TrackerHistoryViewModel">

  <Grid ColumnDefinitions="*,Auto,340">

    <Panel Grid.Column="0">
      <DataGrid Classes="compact"
                ItemsSource="{Binding Exchanges}"
                SelectedItem="{Binding Selected}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{x:Static res:Strings.ColumnTime}" Width="85"
                              Binding="{Binding Timestamp, Mode=OneWay, Converter={x:Static conv:LogTimeConverter.Instance}}" />
          <DataGridTextColumn Header="{x:Static res:Strings.ColumnEvent}" Width="85" Binding="{Binding Kind, Mode=OneWay}" />
          <DataGridTextColumn Header="{x:Static res:Strings.ColumnResult}" Width="*" Binding="{Binding Result, Mode=OneWay}" />
          <DataGridTextColumn Header="{x:Static res:Strings.ColumnInterval}" Width="75" Binding="{Binding Interval, Mode=OneWay}"
                              CellTheme="{StaticResource DataGridCellNumeric}"
                              HeaderTemplate="{StaticResource DataGridHeaderNumeric}" />
          <DataGridTextColumn Header="{x:Static res:Strings.Seeds}" Width="65" Binding="{Binding Complete, Mode=OneWay}"
                              CellTheme="{StaticResource DataGridCellNumeric}"
                              HeaderTemplate="{StaticResource DataGridHeaderNumeric}" />
          <DataGridTextColumn Header="{x:Static res:Strings.Leechers}" Width="80" Binding="{Binding Incomplete, Mode=OneWay}"
                              CellTheme="{StaticResource DataGridCellNumeric}"
                              HeaderTemplate="{StaticResource DataGridHeaderNumeric}" />
          <DataGridTextColumn Header="{x:Static res:Strings.ColumnPeers}" Width="65" Binding="{Binding PeerCount, Mode=OneWay}"
                              CellTheme="{StaticResource DataGridCellNumeric}"
                              HeaderTemplate="{StaticResource DataGridHeaderNumeric}" />
          <DataGridTextColumn Header="{x:Static res:Strings.ColumnLatency}" Width="80" Binding="{Binding DurationMs, Mode=OneWay, StringFormat={x:Static res:Strings.MillisecondsFormat}}"
                              CellTheme="{StaticResource DataGridCellNumeric}"
                              HeaderTemplate="{StaticResource DataGridHeaderNumeric}" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="{x:Static res:Strings.TrackerNoExchanges}" Classes="subtle"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !Exchanges.Count}" />
    </Panel>

    <GridSplitter Grid.Column="1" Width="6" MinWidth="6" Background="Transparent" ResizeDirection="Columns" />

    <Border Grid.Column="2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0">
      <Panel>
        <TextBlock Text="{x:Static res:Strings.TrackerSelectExchange}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,0" Classes="subtle"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />
        <ScrollViewer Padding="12,8" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="6" DataContext="{Binding Selected}" x:DataType="tracker:TrackerExchange">
            <TextBlock Text="{x:Static res:Strings.TrackerRequest}" Classes="section" Margin="0,0,0,2" />
            <SelectableTextBlock Text="{Binding RequestUrl}" TextWrapping="Wrap" Classes="mono" FontSize="11" />
            <TextBlock Text="{x:Static res:Strings.TrackerResponseHeaders}" Classes="section" />
            <SelectableTextBlock Text="{Binding ResponseHeaders}" TextWrapping="Wrap" Classes="mono" FontSize="11" />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>

  </Grid>
</UserControl>

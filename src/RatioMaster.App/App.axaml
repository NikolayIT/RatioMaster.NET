<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RatioMaster.App.Resources"
             xmlns:local="clr-namespace:RatioMaster.App"
             xmlns:vm="clr-namespace:RatioMaster.App.ViewModels"
             xmlns:conv="clr-namespace:RatioMaster.App.Converters"
             x:Class="RatioMaster.App.App"
             x:DataType="vm:MainWindowViewModel"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://RatioMaster.NET/Styles/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RatioMaster.NET/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://RatioMaster.NET/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Fluent sizing overrides: the stock expanders and sort icons are sized for touch. -->
      <x:Double x:Key="ExpanderMinHeight">36</x:Double>
      <Thickness x:Key="ExpanderHeaderPadding">12,0,0,0</Thickness>
      <Thickness x:Key="ExpanderContentPadding">12,10</Thickness>
      <Thickness x:Key="ExpanderChevronMargin">12,0,8,0</Thickness>
      <x:Double x:Key="ExpanderChevronButtonSize">28</x:Double>
      <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

      <!-- Shows an enum value (filter, stop condition, proxy type, theme) by its translated name. -->
      <DataTemplate x:Key="DisplayNameTemplate" x:DataType="x:Object">
        <TextBlock Text="{Binding Converter={x:Static conv:Converters.DisplayName}}" />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>

  <TrayIcon.Icons>
    <TrayIcons>
      <!-- Avalonia creates the icon while this file loads, before the view model is the DataContext, and its macOS
           backend throws on a null tooltip (issue #62), so until then the tooltip is the name. -->
      <TrayIcon Icon="avares://RatioMaster.NET/Assets/app.ico"
                ToolTipText="{Binding TrayToolTip, FallbackValue=RatioMaster.NET}"
                Command="{Binding RestoreCommand}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{x:Static res:Strings.TrayShow}" Command="{Binding RestoreCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{x:Static res:Strings.CommandStartAll}" Command="{Binding StartAllCommand}" />
            <NativeMenuItem Header="{x:Static res:Strings.CommandStopAll}" Command="{Binding StopAllCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{x:Static res:Strings.TrayWebsite}" Command="{Binding OpenUrlCommand}" CommandParameter="https://ratiomaster.net" />
            <NativeMenuItem Header="GitHub" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/NikolayIT/RatioMaster.NET" />
            <NativeMenuItem Header="{x:Static res:Strings.TrayAbout}" Command="{Binding ShowAboutCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

</Application>

<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Required for the XML comment analyzers to run at all (SA0001); CS1591 stays off because
         members are documented where a comment earns its place, not everywhere. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.1.0</Version>
    <Authors>Nikolay Kostov</Authors>
    <Company>Nikolay.IT</Company>
    <Product>RatioMaster.NET</Product>
    <Copyright>Copyright © 2006-2026 Nikolay Kostov</Copyright>
    <RepositoryUrl>https://github.com/NikolayIT/RatioMaster.NET</RepositoryUrl>
    <PackageProjectUrl>https://ratiomaster.net</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
